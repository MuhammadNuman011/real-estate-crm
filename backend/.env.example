PORT=4000
DB_URI=mysql://root:password@127.0.0.1:3306/database
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Hostinger environment variables (set these in hPanel, not in a file):
# NODE_ENV=production
# DB_URI=mysql://DATABASE_USER:DATABASE_PASSWORD@localhost:3306/DATABASE_NAME
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRES_IN=8h
# FRONTEND_URL=https://app.paradiseliferealestate.com
# Hostinger sets PORT itself. Do not upload this file.

# Firebase Admin credentials stay on the server. Set one of these.
# Never ship the service account in the Flutter app.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
